APP_NAME=rag-platform
APP_ENV=development
LOG_LEVEL=INFO

RAG_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Which engine writes the chat answers (switch by changing these lines only):
#   auto              (default) Claude when ANTHROPIC_API_KEY is set, otherwise 'extractive'.
#   anthropic         Claude.                      Needs ANTHROPIC_API_KEY. Default model claude-opus-5.
#   openai            OpenAI.                      Needs OPENAI_API_KEY.    Default model gpt-4o-mini.
#   gemini            Google Gemini.               Needs GEMINI_API_KEY.    Default model gemini-2.5-flash.
#   qwen              Qwen on Alibaba DashScope.   Needs QWEN_API_KEY.      Default model qwen-plus.
#   ollama            Local model via Ollama, free, no key. Default model qwen2.5:1.5b
#                     (run `ollama pull qwen2.5:1.5b` first).
#   openai_compatible Any other OpenAI-compatible endpoint (Groq, OpenRouter, DeepSeek,
#                     vLLM, LM Studio, ...). Needs LLM_BASE_URL and LLM_MODEL; LLM_API_KEY if
#                     the endpoint wants one.
#   extractive        Offline, free: lays out the retrieved records, no generation.
#   stub              Deterministic placeholder used by tests.
# If the selected model is unreachable, errors or refuses, that request is answered by
# the extractive provider instead of failing.
LLM_PROVIDER=ollama
# Empty = the provider's default model (listed above).
LLM_MODEL=qwen2.5:1.5b
# Overrides the provider's endpoint (e.g. DashScope's China region, or a remote Ollama).
# LLM_BASE_URL=
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=120

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# QWEN_API_KEY=sk-...
# LLM_API_KEY=...

OLLAMA_BASE_URL=http://localhost:11434
# Ollama context window (tokens). Must hold the prompt + MAX_CONTEXT_TOKENS + the answer.
OLLAMA_NUM_CTX=4096

# Free, local cross-encoder reranker (no API key). Set RERANKER_PROVIDER=none to disable.
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_MULTIPLIER=4

# Conversation history sent to /api/chat is capped to this many recent turns
# before being used for query rewriting — never sent unbounded.
MAX_HISTORY_TURNS=3

# Guardrails (Plan Set 17): below this cosine similarity, retrieval is treated as
# too weak and the LLM is never called — "insufficient information" is returned directly.
GUARDRAILS_SIMILARITY_THRESHOLD=0.35
# Hard cap on context tokens sent to the LLM, regardless of top_k/chunk_size.
MAX_CONTEXT_TOKENS=1500

# Plan Set 24 — comma-separated list of frontend origins allowed to call this
# API. Defaults to the dev Angular console; set to the real frontend's origin(s)
# in production (e.g. https://app.example.com), never by editing app/main.py.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Used only by config/sports_store_source.yaml (source adapter config), never by RAG core
SPORTS_STORE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ssms_db
# The store's own API (ssms-backend-fastapi). Every chat write (sales, products, stock,
# day management) goes through it so stock, day totals and notifications stay in one place. Run it on
# a port other than this API's 8000, e.g. `uvicorn app.main:app --port 8001`.
SPORTS_STORE_API_URL=http://localhost:8001
# Store login the chat uses for day management (start day, expenses, end day),
# which the store API only allows for a logged-in staff/admin user. Products and
# sales don't need it. Alternatively set SPORTS_STORE_API_TOKEN to a ready token.
SPORTS_STORE_API_MOBILE=
SPORTS_STORE_API_PASSWORD=

# Plan Set 20 — a second, completely unrelated data source (a book catalog, not a
# sports store) proving the RAG core needs zero changes to switch domains.
# Used only by config/library_source.yaml, never by RAG core.
LIBRARY_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/library_db

# /admin/ingest may only load source configs from this directory (defaults to the
# project's config/ folder). Set it only if configs are mounted elsewhere.
# SOURCE_CONFIG_DIR=/app/config
