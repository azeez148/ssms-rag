{
  "family": "rag-app",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/rag-task-execution-role",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/rag-task-role",
  "containerDefinitions": [
    {
      "name": "rag-app",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/rag-app:<TAG>",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "APP_NAME", "value": "rag-platform" },
        { "name": "APP_ENV", "value": "production" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "https://app.example.com" },
        { "name": "RUN_MIGRATIONS", "value": "false" }
      ],
      "secrets": [
        {
          "name": "RAG_DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:rag/database-url"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health', timeout=3).status == 200 else 1)\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rag-app",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
